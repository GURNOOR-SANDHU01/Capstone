# ============================================================
# Sentience Backend Environment Configuration Template
# Copy this file to .env and provide your specific credentials
# ============================================================

# Application Environment
NODE_ENV=development
PORT=5000
# Comma-separated; development mode allows any origin
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# Firebase Project Configuration
FIREBASE_PROJECT_ID=sentience-6f40e
FIREBASE_DATABASE_LOCATION=asia-south1
FIREBASE_AUTH_DOMAIN=sentience-6f40e.firebaseapp.com
FIREBASE_STORAGE_BUCKET=sentience-6f40e.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=773838901854
FIREBASE_WEB_APP_ID=1:773838901854:web:0d735ab31ebb3709821acf
FIREBASE_MEASUREMENT_ID=G-TLELP51BQM

# Firebase Web API Key (from Firebase Console -> Project Settings -> General -> Web API Key)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Firebase Admin SDK Credentials (Optional for local dev with emulator or serviceAccountKey.json)
# Option 1: Path to service account json file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Option 2: Raw JSON string or individual environment credentials
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Optional: Firebase Local Emulator Suite ports
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# AI Model Inference Service
# When MODEL_API_BASE_URL is left empty or USE_MOCK_MODELS=true, the built-in
# MockModelAdapter generates realistic 28-emotion, CBT, intent, and safety signals.
USE_MOCK_MODELS=true
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_API_TIMEOUT_MS=15000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
