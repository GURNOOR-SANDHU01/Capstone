# Store text with LF line endings in git, whatever editor/OS a teammate uses
# (Windows checkouts get CRLF only where a tool needs it).
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files: never touch line endings or diff them as text
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.docx binary
*.pptx binary
*.wav binary
*.webm binary
*.npy binary
*.pt binary
