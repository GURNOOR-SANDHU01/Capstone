# SentiMed frontend configuration (copy to .env.local; never commit real values)
#
# Leave VITE_FIREBASE_API_KEY empty to run the offline Sandbox demo (localStorage only).
# Fill it in to run Live mode: Firebase Authentication + all data through the Express API.

# Firebase web app config (Firebase Console > Project settings > Your apps). These identify the
# project and are not secrets, but keep them out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sentience-6f40e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sentience-6f40e
VITE_FIREBASE_STORAGE_BUCKET=sentience-6f40e.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Express API. Default "/api" uses the Vite dev proxy below; set a full URL for production builds.
VITE_API_BASE_URL=/api
VITE_DEV_API_PROXY_TARGET=http://localhost:5000

# Local end-to-end testing against the Firebase Auth emulator (leave empty for the real project)
VITE_FIREBASE_AUTH_EMULATOR_HOST=
